# Fresh hackathon paper account ONLY (reused accounts are disqualified)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# indicative = free delayed feed; opra requires a paid subscription
OPTION_FEED=indicative

# Universe to screen for term-structure kinks
UNIVERSE=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMD,TSLA

# Risk envelope (deterministic; the model cannot widen these)
MAX_CONCURRENT_POSITIONS=5
MAX_RISK_PER_TRADE_USD=1500
MAX_TOTAL_RISK_USD=6000
MIN_KINK_SCORE=0.03

# Path to the Alpaca CLI binary (falls back to PATH, then ../tools/)
ALPACA_CLI=

# Catalyst adjudicator. Any OpenAI-compatible /chat/completions endpoint works.
#   featherless  https://api.featherless.ai/v1        zai-org/GLM-5.2
#   groq         https://api.groq.com/openai/v1       llama-3.3-70b-versatile
#   openrouter   https://openrouter.ai/api/v1         (many)
#   gemini       https://generativelanguage.googleapis.com/v1beta/openai
#   local        http://localhost:8080/v1             (llama.cpp / ollama)
# With no key the adjudicator refuses every trade -- fail-closed by design.
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_API_KEY=
ADJUDICATOR_MODEL=qwen/qwen3.8-27b

# Alpaca corporate actions has no earnings dates, so single names carry an
# unseeable catalyst risk. Broad ETFs do not. Off by default.
TRADE_SINGLE_NAMES=false
