# Fresh hackathon paper account ONLY (reused accounts are disqualified)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# indicative = free delayed feed; opra requires a paid subscription
OPTION_FEED=indicative

# Universe to screen for term-structure kinks
UNIVERSE=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMD,TSLA

# Risk envelope (deterministic; the model cannot widen these)
MAX_CONCURRENT_POSITIONS=5
MAX_RISK_PER_TRADE_USD=1500
MAX_TOTAL_RISK_USD=6000
MIN_KINK_SCORE=0.15
